  "narrative": {
    "northStar": "事实账本 / Evidence Ledger",
    "overview": "会迹把会议呈现为持续写入、可追溯的事实账本。纸面、时间轨道和专业录音设备的秩序感取代通用卡片仪表盘；品牌识别来自账本结构，而不是装饰色。",
    "keyCharacteristics": [
      "连续记录条取代卡片网格，时间轨道贯穿会议、转录与证据。",
      "纯灰阶语义，状态通过图标、文字、边界和填充共同编码。",
      "录音计时器使用等宽数字，事实音频状态始终紧邻计时与控制。",
      "低曲率、细分隔线、零装饰阴影。",
      "手机单列、平板事实栏与证据工作区。"
    ],
    "rules": [
      {"name": "The Achromatic State Rule", "body": "状态颜色全部来自灰阶；任何状态都必须同时有图标和明确文字。", "section": "colors"},
      {"name": "The Ink Block Rule", "body": "实心墨色只用于当前最重要的动作或状态，同一视口最多出现两个大面积墨块。", "section": "colors"},
      {"name": "The Instrument Number Rule", "body": "大号数字只属于正在变化的录音时间；普通统计不得竞争这一层级。", "section": "typography"},
      {"name": "The Continuous Ledger Rule", "body": "同类记录属于一张连续表面，不为每一行制造独立悬浮卡片。", "section": "layout"},
      {"name": "The Stable Fact Rule", "body": "ASR 降级、错误或新文本不得移动计时器、事实音频状态和结束操作。", "section": "layout"},
      {"name": "The Zero Resting Shadow Rule", "body": "页面、列表行、状态栏和内容分区在静止状态下阴影为零。", "section": "elevation"}
    ],
    "dos": [
      "Do 把会议、转录和证据组织到时间轨道，而不是创建新的卡片类型。",
      "Do 让事实音频状态、计时和结束操作永远先于实时转录。",
      "Do 使用文字、图标、边界和位置共同编码所有状态。",
      "Do 使用 context.theme 与 AppStyle 令牌。"
    ],
    "donts": [
      "Don't 使用红、黄、绿、品牌蓝、渐变、玻璃、发光或 AI 装饰色。",
      "Don't 使用悬浮卡片网格、卡片套卡片或装饰性波形。",
      "Don't 从概念图引入未规划功能或虚构数据。",
      "Don't 覆盖平台原生返回、手势、安全区和辅助技术行为。"
    ]
  }
