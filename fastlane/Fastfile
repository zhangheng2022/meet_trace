default_platform(:ios)
opt_out_usage

platform :ios do
  desc "Upload the signed MeetTrace IPA to TestFlight"
  lane :upload_testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    options = {
      api_key: api_key,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID"),
      ipa: ENV.fetch("IPA_PATH"),
      skip_waiting_for_build_processing: false,
      distribute_external: true,
      groups: [ENV.fetch("TESTFLIGHT_EXTERNAL_GROUP")],
      submit_beta_review: true,
      notify_external_testers: true,
      uses_non_exempt_encryption: false
    }
    changelog = ENV.fetch("TESTFLIGHT_CHANGELOG", "").strip
    changelog = "MeetTrace #{ENV.fetch("RELEASE_ID")}" if changelog.empty?
    options[:changelog] = changelog

    upload_to_testflight(**options)
  end
end

